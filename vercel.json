{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/solve.js": {
      "maxDuration": 30
    },
    "api/solve-status.js": {
      "maxDuration": 30
    },
    "api/solver-worker.js": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "heat-relief-global-solver",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    }
  }
}
